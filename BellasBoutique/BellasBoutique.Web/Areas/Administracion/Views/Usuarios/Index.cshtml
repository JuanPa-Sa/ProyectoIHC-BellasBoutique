@* Responsable: Juan Pablo
   Administración de usuarios (módulo 7): estado de las cuentas y asignación de roles. *@
@{
    ViewData["Title"] = "Usuarios y roles";
    ViewData["Menu"] = "Usuarios";
    ViewData["Migas"] = "Usuarios y roles";

    var usuarios=Model as List<BellasBoutique.Web.Models.Demo.UsuarioDemo> ?? new();
    var roles = new[] { "Cliente", "Vendedor", "Administrador" };
}

<div class="adm-titulo">
    <div>
        <h1>Usuarios y roles</h1>
        <p>@usuarios.Count usuarios &middot; @usuarios.Count(u => u.Activo) cuentas activas</p>
    </div>
</div>

<section class="adm-panel">
    <div class="adm-herramientas">
        <div class="adm-buscador">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
            <input class="adm-input" type="search" placeholder="Buscar por nombre, correo o cédula" aria-label="Buscar usuarios" />
        </div>
        <select class="adm-input adm-input--auto" aria-label="Rol"><option>Todos los roles</option><option>Cliente</option><option>Vendedor</option><option>Administrador</option></select>
        <select class="adm-input adm-input--auto" aria-label="Estado"><option>Todos los estados</option><option>Activas</option><option>Inactivas</option></select>
    </div>

    <div class="adm-tabla-contenedor">
        <table class="adm-tabla">
            <thead>
                <tr>
                    <th class="adm-ordenable">ID</th>
                    <th class="adm-ordenable">Usuario</th>
                    <th>Cédula</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th class="adm-ordenable">Último acceso</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in usuarios)
                {
                    <tr>
                        <td class="adm-mono">@u.Codigo</td>
                        <td>
                            <div class="adm-producto-celda">
                                <span class="adm-avatar">@(u.Nombre.Substring(0, 1))</span>
                                <div>@u.NombreCompleto<small>@u.Correo</small></div>
                            </div>
                        </td>
                        <td class="adm-mono">@u.Cedula</td>
                        <td>
                            <form method="post" action="/Administracion/Usuarios/Cambiar">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id"/><input type="hidden" name="activo" value="@u.Activo.ToString().ToLowerInvariant()"/><select name="rol" class="adm-input adm-input--auto" aria-label="Rol de @u.Nombre" style="height: 30px;" onchange="this.form.submit()">
                                @foreach (var r in roles)
                                {
                                    <option selected="@(r == u.Rol)">@r</option>
                                }
                            </select></form>
                        </td>
                        <td>
                            @if (u.Activo)
                            {
                                <span class="adm-estado adm-estado--exito">Activa</span>
                            }
                            else
                            {
                                <span class="adm-estado">Inactiva</span>
                            }
                        </td>
                        <td class="adm-mono">@u.Ultimo</td>
                        <td>
                            <div class="adm-acciones-fila">
                                @if (u.Activo)
                                {
                                    <form method="post" action="/Administracion/Usuarios/Cambiar">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id"/><input type="hidden" name="rol" value="@u.Rol"/><input type="hidden" name="activo" value="false"/><button class="adm-btn adm-btn--sm adm-btn--peligro" type="submit">Desactivar</button></form>
                                }
                                else
                                {
                                    <form method="post" action="/Administracion/Usuarios/Cambiar">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id"/><input type="hidden" name="rol" value="@u.Rol"/><input type="hidden" name="activo" value="true"/><button class="adm-btn adm-btn--sm" type="submit">Activar</button></form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="adm-pie-tabla"><span>Mostrando 1–@usuarios.Count de @usuarios.Count</span></div>
</section>
