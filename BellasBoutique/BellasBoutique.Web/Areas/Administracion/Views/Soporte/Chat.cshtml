@* Responsable: Eduardo
   Chat en línea del vendedor con los clientes (módulo 6). Los mensajes se guardan en MensajesChat. *@
@{
    ViewData["Title"] = "Chat con clientes";
    ViewData["Menu"] = "Soporte";
    ViewData["Migas"] = "Chat con clientes";
}

<div class="adm-titulo">
    <div>
        <h1>Chat con clientes</h1>
        <p>2 conversaciones sin responder.</p>
    </div>
</div>

<section class="adm-panel adm-chat">
    <div class="adm-conversaciones">
        <div class="adm-buscador">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
            <input class="adm-input" type="search" placeholder="Buscar cliente" aria-label="Buscar conversación" />
        </div>
        <div class="adm-conversacion activo">
            <span class="adm-avatar">A</span>
            <div class="adm-conversacion__texto"><strong>Ana Mora Solís <small>10:04</small></strong><span>Sí, tenemos disponible en S, M y L.</span></div>
        </div>
        <div class="adm-conversacion">
            <span class="adm-avatar">S</span>
            <div class="adm-conversacion__texto"><strong>Sofía Castro Brenes <small>09:51</small></strong><span>Consulta sobre un cambio de talla</span></div>
            <span class="adm-nav__contador" style="align-self: center;">1</span>
        </div>
        <div class="adm-conversacion">
            <span class="adm-avatar">M</span>
            <div class="adm-conversacion__texto"><strong>María Quesada Arias <small>ayer</small></strong><span>¿Hacen envíos a Cartago?</span></div>
            <span class="adm-nav__contador" style="align-self: center;">1</span>
        </div>
    </div>

    <div class="adm-chat__panel">
        <div class="adm-panel__cabecera">
            <div class="adm-producto-celda">
                <span class="adm-avatar">A</span>
                <div><strong>Ana Mora Solís</strong><small>Cliente &middot; <span class="adm-mono">U-0001</span></small></div>
            </div>
            <span class="adm-estado adm-estado--exito">En línea</span>
        </div>
        <div class="adm-chat__mensajes">
            <div class="adm-mensaje adm-mensaje--propio">¡Hola! Soy Laura, de BellasBoutique. ¿En qué le puedo ayudar?<small>10:02</small></div>
            <div class="adm-mensaje adm-mensaje--otro">Hola, ¿el vestido floral viene en talla M?<small>10:03</small></div>
            <div class="adm-mensaje adm-mensaje--propio">Sí, tenemos disponible en S, M y L.<small>10:04</small></div>
        </div>
        <form class="adm-chat__escribir" method="post">
            @Html.AntiForgeryToken()
            <input class="adm-input" type="text" name="mensaje" required placeholder="Escriba una respuesta..." aria-label="Mensaje" />
            <button class="adm-btn adm-btn--primario" type="submit">Enviar</button>
        </form>
    </div>
</section>
