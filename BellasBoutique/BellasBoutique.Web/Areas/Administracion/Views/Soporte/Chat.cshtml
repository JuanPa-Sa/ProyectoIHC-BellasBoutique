@* Responsable: Eduardo
   Chat en línea del vendedor con los clientes (módulo 6). Los mensajes se guardan en MensajesChat. *@
@{
    ViewData["Title"] = "Chat con clientes";
    ViewData["Menu"] = "Soporte";
    ViewData["Migas"] = "Chat con clientes";
}

@{var clientes=(List<BellasBoutique.Web.Models.Demo.UsuarioDemo>)ViewBag.Clientes;var cliente=ViewBag.Cliente as BellasBoutique.Web.Models.Demo.UsuarioDemo;}
<div class="adm-titulo"><div><h1>Chat con clientes</h1><p>@clientes.Count clientes</p></div></div>
<section class="adm-panel adm-chat"><div class="adm-conversaciones"><div class="adm-buscador"><input id="buscarCliente" class="adm-input" type="search" placeholder="Buscar cliente" /></div>
@foreach(var c in clientes){<a class="adm-conversacion @(cliente?.Id==c.Id?"activo":"")" href="/Administracion/Soporte/Chat?id=@c.Id"><span class="adm-avatar">@c.Nombre.Substring(0,1)</span><div class="adm-conversacion__texto"><strong>@c.NombreCompleto</strong><span>@c.Codigo</span></div></a>}
</div><div class="adm-chat__panel">@if(cliente!=null){<div class="adm-panel__cabecera"><strong>@cliente.NombreCompleto</strong></div><div class="adm-chat__mensajes" id="mensajes"></div><form class="adm-chat__escribir" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@cliente.Id"/><input class="adm-input" name="mensaje" required maxlength="1000" placeholder="Escriba una respuesta..."/><button class="adm-btn adm-btn--primario" type="submit">Enviar</button></form>}else{<p>No hay clientes registrados.</p>}</div></section>
<script src="/js/chat.js"></script>
@if(cliente!=null){<script>cargarChat('/Administracion/Soporte/Mensajes?id=@cliente.Id',@(Context.Session.GetInt32("UsuarioId")??0),'adm');</script>}
<script>document.getElementById('buscarCliente').oninput=function(){document.querySelectorAll('.adm-conversacion').forEach(a=>a.hidden=!a.textContent.toLowerCase().includes(this.value.toLowerCase()));};</script>