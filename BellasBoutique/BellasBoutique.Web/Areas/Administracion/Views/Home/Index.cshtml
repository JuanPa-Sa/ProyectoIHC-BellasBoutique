@* Responsable: Joel
   Página de inicio del panel: resumen del día. *@
@{
    ViewData["Title"] = "Resumen";
    ViewData["Menu"] = "Inicio";
    ViewData["Migas"] = "Resumen";

    var ventas=(List<BellasBoutique.Web.Models.Demo.VentaFila>)ViewBag.Ventas;
    var pagos=(List<BellasBoutique.Web.Models.Demo.PagoFila>)ViewBag.Pagos;
    var stock=(List<BellasBoutique.Web.Models.Demo.ProductoDemo>)ViewBag.Stock;
    var hoy=ventas.Where(v=>v.FechaReal.Date==DateTime.Today).ToList();
    var ultimas=pagos.Take(5);
    var dias=(string)ViewBag.Periodo=="mes"?30:7;
    var cifras=Enumerable.Range(0,dias).Select(i=>{var d=DateTime.Today.AddDays(i-dias+1);return (d.ToString("dd/MM"),ventas.Where(v=>v.FechaReal.Date==d).Sum(v=>v.Precio*v.Cantidad));}).ToArray();
    var max=Math.Max(1m,cifras.Max(v=>v.Item2));
    var semana=cifras.Select(v=>(v.Item1,(int)(v.Item2*100/max)));
}

<div class="adm-titulo">
    <div>
        <h1>Resumen del día</h1>
        <p>Datos de ventas &middot; actualizado a las @DateTime.Now.ToString("HH:mm")</p>
    </div>
    <div style="display: flex; gap: 8px;">
        <a class="adm-btn" href="/Administracion/Reportes/FinDelDia">Reporte del día</a>
        <a class="adm-btn adm-btn--acento" href="/Administracion/Productos/Formulario">+ Registrar producto</a>
    </div>
</div>

<div class="adm-kpis">
    <div class="adm-kpi">
        <div class="adm-kpi__etiqueta">Productos vendidos</div>
        <div class="adm-kpi__valor">@hoy.Sum(v=>v.Cantidad)</div>
        <div class="adm-kpi__delta adm-kpi__delta--sube">Unidades del día</div>
    </div>
    <div class="adm-kpi">
        <div class="adm-kpi__etiqueta">Ingresos</div>
        <div class="adm-kpi__valor">₡@(hoy.Sum(v=>v.Cantidad*v.Precio).ToString("N0"))</div>
        <div class="adm-kpi__delta adm-kpi__delta--sube">Antes de IVA</div>
    </div>
    <div class="adm-kpi">
        <div class="adm-kpi__etiqueta">Stock bajo</div>
        <div class="adm-kpi__valor">@stock.Count</div>
        <div class="adm-kpi__delta adm-kpi__delta--baja">Requiere reposición</div>
    </div>
    <div class="adm-kpi">
        <div class="adm-kpi__etiqueta">Pagos pendientes</div>
        <div class="adm-kpi__valor">@pagos.Count(p=>p.Estado=="Pendiente")</div>
        <div class="adm-kpi__delta adm-suave">Simulaciones pendientes</div>
    </div>
</div>

<div class="adm-columnas">
    <section class="adm-panel">
        <div class="adm-panel__cabecera">
            <h2>Ingresos del periodo</h2>
            <select class="adm-input adm-input--auto" aria-label="Periodo" onchange="location.href='/Administracion/Home?periodo='+this.value"><option value="semana" selected="@((string)ViewBag.Periodo!="mes")">Esta semana</option><option value="mes" selected="@((string)ViewBag.Periodo=="mes")">Este mes</option></select>
        </div>
        <div class="adm-panel__cuerpo">
            <div class="adm-grafico">
                @foreach (var (dia, valor) in semana)
                {
                    <div class="adm-grafico__col">
                        <div class="adm-grafico__barra" style="height: @(valor)%;" title="@dia"></div>
                        <small>@dia</small>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="adm-panel">
        <div class="adm-panel__cabecera">
            <h2>Stock bajo</h2>
            <a class="adm-btn adm-btn--sm" href="/Administracion/Productos">Ver productos</a>
        </div>
        <ul class="adm-lista">
            @foreach(var p in stock){<li><span>@p.Nombre</span><span class="adm-estado adm-estado--error">@p.Stock unidades</span></li>}
        </ul>
    </section>
</div>

<section class="adm-panel">
    <div class="adm-panel__cabecera">
        <h2>Últimas facturas</h2>
        <a class="adm-btn adm-btn--sm" href="/Administracion/Ventas">Ver ventas</a>
    </div>
    <div class="adm-tabla-contenedor">
        <table class="adm-tabla">
            <thead>
                <tr>
                    <th>Factura</th>
                    <th>Cliente</th>
                    <th>Método</th>
                    <th>Estado del pago</th>
                    <th class="adm-numero">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in ultimas)
                {
                    var clase = f.Estado == "Exitoso" ? "adm-estado--exito" : f.Estado == "Pendiente" ? "adm-estado--aviso" : "adm-estado--error";
                    <tr>
                        <td class="adm-mono">@f.Factura</td>
                        <td>@f.Cliente</td>
                        <td>@f.Metodo</td>
                        <td><span class="adm-estado @clase">@f.Estado</span></td>
                        <td class="adm-numero">₡@(f.Total.ToString("N0"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
