@* Responsable: Joel
   Reportes diarios y mensuales (módulo 5): cantidad de productos vendidos e ingresos generados. *@
@{
    ViewData["Title"] = "Reportes";
    ViewData["Menu"] = "Reportes";
    ViewData["Migas"] = "Reportes";
    ViewData["Pestana"] = "Diario";

    // Datos de SQL Server.
    var filas = ((List<BellasBoutique.Web.Models.Demo.VentaFila>)Model).GroupBy(v=>new{v.Producto,v.Categoria}).Select(g=>new{g.Key.Producto,g.Key.Categoria,Cantidad=g.Sum(v=>v.Cantidad),Ingresos=g.Sum(v=>v.Precio*v.Cantidad)}).ToArray();
    var total = filas.Sum(f => f.Ingresos);
}

<div class="adm-titulo">
    <div>
        <h1>Reportes de ventas</h1>
        <p>Productos vendidos e ingresos generados por periodo.</p>
    </div>
    <div style="display: flex; gap: 8px;">
        <select id="tipoReporte" class="adm-input adm-input--auto" aria-label="Periodo"><option value="diario" selected="@((string)ViewBag.Tipo!="mensual")">Diario</option><option value="mensual" selected="@((string)ViewBag.Tipo=="mensual")">Mensual</option></select>
        <input id="fechaReporte" class="adm-input adm-input--auto" type="date" aria-label="Fecha" value="@(((DateTime)ViewBag.Fecha).ToString("yyyy-MM-dd"))" />
    </div>
</div>

<partial name="_MenuReportes" />

<div class="adm-kpis" style="grid-template-columns: repeat(3, 1fr);">
    <div class="adm-kpi">
        <div class="adm-kpi__etiqueta">Productos vendidos</div>
        <div class="adm-kpi__valor">@filas.Sum(f => f.Cantidad)</div>
    </div>
    <div class="adm-kpi">
        <div class="adm-kpi__etiqueta">Ingresos generados</div>
        <div class="adm-kpi__valor">₡@(total.ToString("N0"))</div>
    </div>
    <div class="adm-kpi">
        <div class="adm-kpi__etiqueta">Productos distintos</div>
        <div class="adm-kpi__valor">@filas.Length</div>
    </div>
</div>

<section class="adm-panel">
    <div class="adm-panel__cabecera"><h2>Detalle por producto</h2></div>
    <div class="adm-tabla-contenedor">
        <table class="adm-tabla">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th class="adm-numero">Cantidad vendida</th>
                    <th class="adm-numero">Ingresos</th>
                    <th>% de los ingresos</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in filas)
                {
                    var porcentaje = total==0?0:(int)Math.Round(f.Ingresos * 100 / total);
                    <tr>
                        <td>@f.Producto</td>
                        <td>@f.Categoria</td>
                        <td class="adm-numero">@f.Cantidad</td>
                        <td class="adm-numero">₡@(f.Ingresos.ToString("N0"))</td>
                        <td>
                            <div class="adm-participacion">
                                <div class="adm-stock__barra"><span style="width: @(porcentaje)%;"></span></div>
                                <span class="adm-mono">@porcentaje%</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<div class="adm-form-acciones" style="margin:24px 0"><a class="adm-btn adm-btn--acento" href="/Administracion/Reportes/Descargar?tipo=@ViewBag.Tipo&fecha=@(((DateTime)ViewBag.Fecha).ToString("yyyy-MM-dd"))" id="descargarReporte">Generar y descargar PDF</a></div>
<script>const cambiar=()=>location.href='/Administracion/Reportes?tipo='+document.getElementById('tipoReporte').value+'&fecha='+document.getElementById('fechaReporte').value;document.getElementById('tipoReporte').onchange=cambiar;document.getElementById('fechaReporte').onchange=cambiar;</script>