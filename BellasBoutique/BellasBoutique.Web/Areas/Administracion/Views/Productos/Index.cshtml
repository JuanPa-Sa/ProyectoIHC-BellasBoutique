@* Responsable: Eduardo
   Gestión de productos (módulo 3): registrar, modificar, actualizar stock y dar de baja. *@
@{
    ViewData["Title"] = "Productos";
    ViewData["Menu"] = "Productos";
    ViewData["Migas"] = "Productos";

    var productos=Model as List<BellasBoutique.Web.Models.Demo.ProductoDemo> ?? new();
    const int stockReferencia = 20; // solo para dibujar la barra de ejemplo
}

@if(TempData["Aviso"]!=null){<p role="status">@TempData["Aviso"]</p>}
<div class="adm-titulo">
    <div>
        <h1>Productos</h1>
        <p>@productos.Count productos &middot; @productos.Count(p => p.Stock <= 3 && p.Activo) con stock bajo</p>
    </div>
    <a class="adm-btn adm-btn--acento" href="/Administracion/Productos/Formulario">+ Registrar producto</a>
</div>

<section class="adm-panel">
    <div class="adm-herramientas">
        <div class="adm-buscador">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
            <input class="adm-input" type="search" placeholder="Buscar por nombre o código" aria-label="Buscar productos" />
        </div>
        <select class="adm-input adm-input--auto" aria-label="Categoría">
            <option>Todas las categorías</option><option>Ropa</option><option>Calzado</option><option>Accesorios</option>
        </select>
        <select class="adm-input adm-input--auto" aria-label="Estado">
            <option>Todos los estados</option><option>Activos</option><option>Dados de baja</option>
        </select>
    </div>

    <div class="adm-tabla-contenedor">
        <table class="adm-tabla">
            <thead>
                <tr>
                    <th class="adm-check"><input type="checkbox" aria-label="Seleccionar todos" /></th>
                    <th class="adm-ordenable">Producto</th>
                    <th>Código</th>
                    <th>Categoría</th>
                    <th>Proveedor</th>
                    <th class="adm-numero adm-ordenable">Precio</th>
                    <th class="adm-ordenable">Stock</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in productos)
                {
                    var nivel = p.Stock <= 3 ? "adm-stock--bajo" : p.Stock <= 8 ? "adm-stock--medio" : "";
                    var ancho = Math.Min(100, p.Stock * 100 / stockReferencia);
                    <tr>
                        <td class="adm-check"><input type="checkbox" aria-label="Seleccionar @p.Nombre" /></td>
                        <td>
                            <div class="adm-producto-celda">
                                <div class="adm-miniatura"></div>
                                <div>@p.Nombre</div>
                            </div>
                        </td>
                        <td class="adm-mono">@p.Codigo</td>
                        <td>@p.Categoria</td>
                        <td>@p.Proveedor</td>
                        <td class="adm-numero">₡@(p.Precio.ToString("N0"))</td>
                        <td>
                            <div class="adm-stock @nivel">
                                <span class="adm-mono">@p.Stock</span>
                                <div class="adm-stock__barra"><span style="width: @(ancho)%;"></span></div>
                            </div>
                        </td>
                        <td>
                            @if (p.Activo)
                            {
                                <span class="adm-estado adm-estado--exito">Activo</span>
                            }
                            else
                            {
                                <span class="adm-estado">Dado de baja</span>
                            }
                        </td>
                        <td>
                            <div class="adm-acciones-fila">
                                <a class="adm-btn adm-btn--sm" href="/Administracion/Productos/Formulario?id=@p.Id">Modificar</a>
                                <form method="post" action="/Administracion/Productos/Stock" style="display:inline-flex;gap:4px">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"/><input type="number" name="stock" value="@p.Stock" min="0" style="width:64px" aria-label="Stock"/><button class="adm-btn adm-btn--sm" type="submit">Stock</button></form>
                                <form method="post" action="/Administracion/Productos/Baja" style="display:inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"/><button class="adm-btn adm-btn--sm adm-btn--peligro" type="submit">Dar de baja</button></form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="adm-pie-tabla">
        <span>Mostrando 1–@productos.Count de @productos.Count</span>
        <div class="adm-paginas">
            <button class="adm-btn adm-btn--icono adm-btn--sm" type="button" aria-label="Anterior">&lsaquo;</button>
            <button class="adm-btn adm-btn--icono adm-btn--sm activo" type="button">1</button>
            <button class="adm-btn adm-btn--icono adm-btn--sm" type="button" aria-label="Siguiente">&rsaquo;</button>
        </div>
    </div>
</section>
