@* Responsable: Juan Pablo
   Bitácora de actividades (req. 8c): altas, bajas, modificaciones y compras de usuarios y administradores. *@
@{
    ViewData["Title"] = "Bitácora";
    ViewData["Menu"] = "Bitacora";
    ViewData["Migas"] = "Bitácora";

    // Datos de SQL Server.
    var registros = (List<BellasBoutique.Web.Models.Demo.BitacoraFila>)Model;
    string Clase(string a) => a switch { "Alta" => "adm-estado--exito", "Baja" => "adm-estado--error", "Modificación" => "adm-estado--info", _ => "adm-estado--acento" };
}

<div class="adm-titulo">
    <div>
        <h1>Bitácora de actividades</h1>
        <p>Registro de altas, bajas, modificaciones y compras.</p>
    </div>
</div>

<section class="adm-panel">
    <div class="adm-herramientas">
        <div class="adm-buscador">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
            <input class="adm-input" type="search" placeholder="Buscar por usuario o detalle" aria-label="Buscar en la bitácora" />
        </div>
        <select class="adm-input adm-input--auto" aria-label="Acción"><option>Todas las acciones</option><option>Alta</option><option>Baja</option><option>Modificación</option><option>Compra</option></select>
        <input class="adm-input adm-input--auto" type="date" aria-label="Desde" />
        <input class="adm-input adm-input--auto" type="date" aria-label="Hasta" />
    </div>

    <div class="adm-tabla-contenedor">
        <table class="adm-tabla">
            <thead>
                <tr>
                    <th class="adm-ordenable">Fecha y hora</th>
                    <th>Usuario</th>
                    <th>Rol</th>
                    <th>Acción</th>
                    <th>Detalle</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in registros)
                {
                    <tr>
                        <td class="adm-mono">@r.Fecha</td>
                        <td>@r.Usuario</td>
                        <td><span class="adm-rol">@r.Rol</span></td>
                        <td><span class="adm-estado @Clase(r.Accion)">@r.Accion</span></td>
                        <td>@r.Detalle</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="adm-pie-tabla"><span>Mostrando 1–@registros.Count de @registros.Count registros</span></div>
</section>

<script>document.addEventListener('DOMContentLoaded',()=>{const controls=[...document.querySelectorAll('.adm-herramientas input,.adm-herramientas select')];function filter(){const q=controls[0].value.toLowerCase();const dates=controls.filter(x=>x.type==='date');const sel=controls.find(x=>x.tagName==='SELECT');document.querySelectorAll('tbody tr').forEach(r=>{const parts=r.cells[0].textContent.trim().slice(0,10).split('/');const d=parts.reverse().join('-');r.hidden=!(r.textContent.toLowerCase().includes(q)&&(!sel||sel.selectedIndex===0||r.cells[3].textContent.trim()===sel.value)&&(!dates[0].value||d>=dates[0].value)&&(!dates[1].value||d<=dates[1].value));});}controls.forEach(x=>x.addEventListener('input',filter));});</script>