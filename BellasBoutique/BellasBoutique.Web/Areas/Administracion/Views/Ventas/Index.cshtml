@* Responsable: Joel
   Historial de ventas (módulo 5): producto, cantidad, precio unitario y fecha de venta (tabla Ventas). *@
@{
    ViewData["Title"] = "Ventas";
    ViewData["Menu"] = "Ventas";
    ViewData["Migas"] = "Ventas";

    // Datos de SQL Server.
    var ventas = (List<BellasBoutique.Web.Models.Demo.VentaFila>)Model;
}

<div class="adm-titulo">
    <div>
        <h1>Historial de ventas</h1>
        <p>@ventas.Sum(v => v.Cantidad) productos vendidos &middot; ₡@(ventas.Sum(v => v.Precio * v.Cantidad).ToString("N0")) en el periodo</p>
    </div>
    <a class="adm-btn" href="/Administracion/Reportes">Ver reportes</a>
</div>

<section class="adm-panel">
    <div class="adm-herramientas">
        <div class="adm-buscador">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
            <input class="adm-input" type="search" placeholder="Buscar producto o factura" aria-label="Buscar ventas" />
        </div>
        <input class="adm-input adm-input--auto" type="date" aria-label="Desde" />
        <input class="adm-input adm-input--auto" type="date" aria-label="Hasta" />
    </div>

    <div class="adm-tabla-contenedor">
        <table class="adm-tabla">
            <thead>
                <tr>
                    <th class="adm-ordenable">Fecha de venta</th>
                    <th>Factura</th>
                    <th class="adm-ordenable">Producto</th>
                    <th class="adm-numero">Cantidad</th>
                    <th class="adm-numero">Precio unitario</th>
                    <th class="adm-numero adm-ordenable">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in ventas)
                {
                    <tr>
                        <td class="adm-mono">@v.Fecha</td>
                        <td class="adm-mono">@v.Factura</td>
                        <td>@v.Producto</td>
                        <td class="adm-numero">@v.Cantidad</td>
                        <td class="adm-numero">₡@(v.Precio.ToString("N0"))</td>
                        <td class="adm-numero">₡@((v.Precio * v.Cantidad).ToString("N0"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="adm-pie-tabla"><span>Mostrando 1–@ventas.Count de @ventas.Count</span></div>
</section>

<script>document.addEventListener('DOMContentLoaded',()=>{const controls=[...document.querySelectorAll('.adm-herramientas input,.adm-herramientas select')];function filter(){const q=controls[0].value.toLowerCase();const dates=controls.filter(x=>x.type==='date');const sel=controls.find(x=>x.tagName==='SELECT');document.querySelectorAll('tbody tr').forEach(r=>{const parts=r.cells[0].textContent.trim().slice(0,10).split('/');const d=parts.reverse().join('-');r.hidden=!(r.textContent.toLowerCase().includes(q)&&(!sel||sel.selectedIndex===0||r.cells[3].textContent.trim()===sel.value)&&(!dates[0].value||d>=dates[0].value)&&(!dates[1].value||d<=dates[1].value));});}controls.forEach(x=>x.addEventListener('input',filter));});</script>