@* Responsable: Eduardo
   Chat en línea del cliente con el vendedor (módulo 6). *@
@{
    ViewData["Title"] = "Chat en línea";
    ViewData["Menu"] = "Soporte";
    ViewData["Pestana"] = "Chat";
}
<partial name="_MenuSoporte" />

<div class="bb-contenedor" style="padding-bottom: 88px;">
    <div class="bb-chat">
        <div class="bb-chat__cabecera">
            <span class="bb-chat__avatar">L</span>
            <div><strong>Soporte BellasBoutique</strong><small>Conversación con el equipo</small></div>
        </div>
        <div class="bb-chat__mensajes" id="mensajes"></div>
        <form class="bb-chat__escribir" method="post">
            @Html.AntiForgeryToken()
            <input type="text" name="mensaje" required placeholder="Escriba un mensaje..." aria-label="Mensaje" />
            <button class="bb-btn" type="submit">Enviar</button>
        </form>
    </div>
</div>

<script src="/js/chat.js"></script><script>cargarChat('/Soporte/Mensajes',@(Context.Session.GetInt32("UsuarioId")??0),'bb');</script>