@* Responsable: Eduardo
   Catálogo (módulo 3): imagen, nombre, descripción, precio, stock, categoría, proveedor,
   filtro por categoría y botón añadir al carrito con cantidad. *@
@{
    ViewData["Title"] = "Catálogo";
    ViewData["Menu"] = "Catalogo";

    var productos = Model as List<BellasBoutique.Web.Models.Demo.ProductoDemo> ?? new();
}

<section class="bb-cabecera-pagina">
    <div class="bb-contenedor">
        <div class="bb-migas"><a href="/">Inicio</a><span>Catálogo</span></div>
        <h1>Catálogo</h1>
        <p class="bb-texto-suave" style="margin: 0;">Ropa, calzado y accesorios disponibles.</p>
    </div>
</section>

<div class="bb-contenedor">
    @if(TempData["Aviso"]!=null){<p role="alert">@TempData["Aviso"]</p>}
    <div class="bb-catalogo">
        <aside class="bb-filtros" aria-label="Filtros">
            <h4>Categorías</h4>
            <ul>
                <li><label class="bb-check"><input type="checkbox" checked="@(ViewBag.Categoria == null)" onchange="location.href='/Catalogo'" /> Todas <small>@productos.Count</small></label></li>
                <li><label class="bb-check"><input type="checkbox" onchange="location.href='/Catalogo?categoria=Ropa'" checked="@(ViewBag.Categoria == "Ropa")" /> Ropa <small>@productos.Count(p=>p.Categoria=="Ropa")</small></label></li>
                <li><label class="bb-check"><input type="checkbox" onchange="location.href='/Catalogo?categoria=Calzado'" checked="@(ViewBag.Categoria == "Calzado")" /> Calzado <small>@productos.Count(p=>p.Categoria=="Calzado")</small></label></li>
                <li><label class="bb-check"><input type="checkbox" onchange="location.href='/Catalogo?categoria=Accesorios'" checked="@(ViewBag.Categoria == "Accesorios")" /> Accesorios <small>@productos.Count(p=>p.Categoria=="Accesorios")</small></label></li>
            </ul>
        </aside>

        <div>
            <div class="bb-barra-resultados">
                <span>Mostrando @productos.Count productos</span>
            </div>

            <div class="bb-grid-productos">
                @foreach (var p in productos)
                {
                    <article class="bb-producto">
                        <div class="bb-producto__media">
                            @if(!string.IsNullOrWhiteSpace(p.Imagen)){<img src="@p.Imagen" alt="@p.Nombre" style="width:100%;height:100%;object-fit:cover" />}else{<div class="bb-imagen-vacia">Foto del producto</div>}
                            <form class="bb-producto__accion" method="post" action="/Carrito/Agregar">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@p.Id" />
                                <input name="cantidad" type="number" min="1" max="@p.Stock" value="1" aria-label="Cantidad de @p.Nombre" />
                                <button class="bb-btn bb-btn--pequeno" type="submit">Añadir</button>
                            </form>
                        </div>
                        <div class="bb-producto__info">
                            <span class="bb-etiqueta">@p.Categoria</span>
                            <h3 class="bb-producto__nombre">@p.Nombre</h3>
                            <span class="bb-producto__precio">₡@(p.Precio.ToString("N0"))</span>
                            <span class="bb-producto__datos">@p.Descripcion</span>
                            <span class="bb-producto__datos">@p.Stock disponibles &middot; @p.Proveedor</span>
                        </div>
                    </article>
                }
            </div>
        </div>
    </div>
</div>
