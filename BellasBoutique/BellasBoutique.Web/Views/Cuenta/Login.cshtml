@* Responsable: Juan Pablo
   Login con correo y contraseña; redirige a Cliente o Administración según el rol. *@
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutAcceso";
}

<form class="bb-acceso__form" method="post">
    <h1>Iniciar sesión</h1>
    <p>Ingrese con su correo y contraseña.</p>

    <div class="bb-campo">
        <label for="correo">Correo electrónico</label>
        <input id="correo" name="correo" type="email" placeholder="nombre@correo.com" />
    </div>
    <div class="bb-campo">
        <label for="contrasena">Contraseña</label>
        <input id="contrasena" name="contrasena" type="password" />
    </div>

    <button class="bb-btn bb-btn--bloque" type="button">Ingresar</button>

    <div class="bb-enlaces-formulario">
        <a href="/Cuenta/RecuperarContrasena">¿Olvidó su contraseña?</a>
        <a href="/Cuenta/Registro">Crear una cuenta</a>
    </div>
</form>
